		<Mod id="napoleon-alt" />
		<Mod id="nepal" />
		<Mod id="ottomans" />
		<Mod id="pirate-republic" />
		<Mod id="qajar" />
		<Mod id="sayyida-al-hurra" />
		<Mod id="sengoku" />
		<Mod id="shawnee-tecumseh" />
		<Mod id="silla" />
		<Mod id="tonga" />
		<Mod id="toyotomi-hideyoshi" />
		<Mod id="trung-nhi" />
		<Mod id="washington" />
		<Mod id="water-wonders" />
		<Mod id="yi-sun-sin" />
	</References>
	<ActionCriteria>
		<Criteria id="realistic-x2">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SpeedType</ConfigurationId>
				<Value>GAMESPEED_ANTHRO_REALISTIC_X2</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<Criteria id="realistic-x3">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SpeedType</ConfigurationId>
				<Value>GAMESPEED_ANTHRO_REALISTIC_X3</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<Criteria id="realistic-x4">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SpeedType</ConfigurationId>
				<Value>GAMESPEED_ANTHRO_REALISTIC_X4</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<Criteria id="realistic-x5">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SpeedType</ConfigurationId>
				<Value>GAMESPEED_ANTHRO_REALISTIC_X5</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<Criteria id="realistic-x6">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SpeedType</ConfigurationId>
				<Value>GAMESPEED_ANTHRO_REALISTIC_X6</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<Criteria id="antiquity">
			<AgeInUse>AGE_ANTIQUITY</AgeInUse>
		</Criteria>
		<Criteria id="realistic-x10">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SpeedType</ConfigurationId>
				<Value>GAMESPEED_ANTHRO_REALISTIC_X10</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<Criteria id="realistic-x20">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>SpeedType</ConfigurationId>
				<Value>GAMESPEED_ANTHRO_REALISTIC_X20</Value>
			</ConfigurationValueMatches>
		</Criteria>
		<Criteria id="exploration">
			<AgeInUse>AGE_EXPLORATION</AgeInUse>
		</Criteria>
		<Criteria id="modern">
			<AgeInUse>AGE_MODERN</AgeInUse>
		</Criteria>
		<Criteria id="ynamp">
			<ModInUse>ged-ynamp</ModInUse>
		</Criteria>
		<Criteria id="always">
			<AlwaysMet />
		</Criteria>
	</ActionCriteria>
	<ActionGroups>
		<ActionGroup id="civilizations-shell" scope="shell" criteria="always">
			<Properties>
				<LoadOrder>1000</LoadOrder>
			</Properties>
			<Actions>
				<UpdateDatabase>
					<Item>config/Civilizations.xml</Item>
				</UpdateDatabase>
				<UpdateText>
					<Item>text/en_us/Civilizations.xml</Item>
				</UpdateText>
				<UpdateIcons>
					<Item>data/civilization-icons.xml</Item>
				</UpdateIcons>
				<UpdateVisualRemaps>
					<Item>data/civilization-visual-remaps.xml</Item>
				</UpdateVisualRemaps>
				<UIScripts>
					<Item>ui/map/anthroprocenia-civilization-backgrounds.js</Item>
				</UIScripts>
				<ImportFiles>
					<Item>ui/map/anthroprocenia-civilization-art.js</Item>
