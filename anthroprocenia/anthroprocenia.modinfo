		<Mod id="bulgaria" />
		<Mod id="carthage" />
		<Mod id="dai-viet" />
		<Mod id="edward-teach" />
		<Mod id="elizabeth" />
		<Mod id="england" />
		<Mod id="friedrich-xerxes-alt" />
		<Mod id="gaul" />
