<?xml version='1.0' encoding='utf-8'?>
<Mod xmlns="ModInfo" id="anthroprocenia_map_history" version="128">
	<Properties>
		<Name>Anthroprocenia</Name>
		<Description>Explore a historical map of your Civilization VII game with replay, geographic labels, and customizable map layers.</Description>
		<Authors>jmiller3496</Authors>
		<EnabledByDefault>1</EnabledByDefault>
		<ShowInBrowser>1</ShowInBrowser>
		<AffectsSavedGames>1</AffectsSavedGames>
	</Properties>
	<Dependencies>
		<Mod id="base-standard" title="LOC_MODULE_BASE_STANDARD_NAME" />
	</Dependencies>
	<References>
		<Mod id="age-antiquity" />
		<Mod id="age-exploration" />
		<Mod id="age-modern" />
		<Mod id="ged-ynamp" />
		<Mod id="ada-lovelace" />
		<Mod id="alexander" />
		<Mod id="ashoka-himiko-alt" />
		<Mod id="asia-wonders" />
		<Mod id="assyria" />
